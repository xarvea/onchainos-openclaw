# ==============================================================================
# MICOW environment — EXAMPLE ONLY. Copy to `.env` (gitignored) and fill in.
# ==============================================================================
# RULES
# - Never commit `.env`. It is gitignored.
# - Anything prefixed NEXT_PUBLIC_ is exposed to the browser. NO SECRETS there.
# - Server-only secrets stay server-side (never imported by client components).
# ==============================================================================

# --- App ---
# NOTE: do NOT set NODE_ENV here. The tooling sets it per command (dev/build/test);
# setting NODE_ENV=development in .env breaks `next build` if the file is sourced.
LOG_LEVEL=info
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Solana (public) ---
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# Leave empty to use the public cluster RPC; set a Helius/QuickNode URL for prod.
NEXT_PUBLIC_SOLANA_RPC_URL=

# --- Solana infrastructure (SERVER-ONLY) ---
# Get a key at https://www.helius.dev/ (DAS + webhooks + enhanced tx)
HELIUS_API_KEY=
# Shared secret for POST /api/webhooks/helius (register the same value in the
# Helius dashboard). Unset → the webhook endpoint returns 503 (fail-closed).
HELIUS_WEBHOOK_SECRET=

# --- Launch / mint: Candy Machine v3 + Core (SERVER-ONLY) ---
# Path to the Solana CLI keypair (JSON array) used as the ADMIN/authority that
# creates collections, candy machines, and inserts items. NEVER a browser value.
# Default (devnet): ~/.config/solana/devnet.json
SOLANA_KEYPAIR_PATH=
# RPC used by the admin/launch scripts (server-side). Falls back to
# NEXT_PUBLIC_SOLANA_RPC_URL, then the public devnet RPC.
SOLANA_RPC_URL=
# Public base URI where uploaded metadata JSON + images are reachable (IPFS
# gateway or your own CDN). Used to build collection/asset `uri`s.
# Example (Pinata gateway): https://gateway.pinata.cloud
NEXT_PUBLIC_ASSET_BASE_URI=

# --- Asset metadata storage (SERVER-ONLY) ---
# Which durable storage the launch scripts use:
#   inline = data: URI (dev/test only — not durable, huge on-chain)
#   http   = POST to ASSET_STORAGE_ENDPOINT, expects `{ uri }` back
#   pinata = IPFS via Pinata (recommended for real deployments)
ASSET_STORAGE_DRIVER=inline
# Pinata JWT (Bearer). Required when ASSET_STORAGE_DRIVER=pinata.
# Create one at https://app.pinata.cloud/developers/api-keys (scope: pinFileToIPFS, pinJSONToIPFS).
PINATA_JWT=
# Public IPFS gateway used to build read URIs (default: https://gateway.pinata.cloud).
IPFS_GATEWAY=https://gateway.pinata.cloud
# Driver "http" only: endpoint that accepts an upload and returns `{ uri }`.
ASSET_STORAGE_ENDPOINT=
# Driver "http" only: optional bearer token sent as `Authorization`.
ASSET_STORAGE_TOKEN=

# --- Mint guards / economics (public; shown in UI, safe to expose) ---
# Mint price in SOL for the public mint guard (solPayment). "0" = free mint.
NEXT_PUBLIC_MINT_PRICE_SOL=0.01
# Max mints per wallet (mintLimit guard).
NEXT_PUBLIC_MINT_LIMIT_PER_WALLET=2
# Royalty / platform fee in basis points (0-10000). 500 = 5%.
NEXT_PUBLIC_ROYALTY_BPS=500
# Platform treasury wallet that receives mint proceeds + fees (solPayment dest).
NEXT_PUBLIC_TREASURY_WALLET=

# --- Database (SERVER-ONLY) ---
# Local example: postgres://micow:micow@localhost:5432/micow
DATABASE_URL=postgres://micow:micow@localhost:5432/micow

# --- Cache / queue (SERVER-ONLY, optional for M1) ---
REDIS_URL=redis://localhost:6379

# --- Object storage for asset caching (SERVER-ONLY, optional) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
